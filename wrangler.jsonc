{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-wardrobe",
  "main": "backend/cloudflare/worker.py",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./frontend/dist/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "WARDROBE_DB",
      "database_name": "my-wardrobe-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "backend/cloudflare/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "WARDROBE_IMAGES",
      "bucket_name": "my-wardrobe-images"
    }
  ]
}
