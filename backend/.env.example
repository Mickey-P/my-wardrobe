# Local-only API access is disabled by default.
# Set both values on a hosted deployment; never put real values in source control.
WARDROBE_REQUIRE_AUTH=true
WARDROBE_API_TOKEN=replace-with-a-long-random-secret

# Use a hosted PostgreSQL URL for a hosted API; local default is SQLite.
# WARDROBE_DATABASE_URL=postgresql+psycopg://user:password@host/database

# Comma-separated origins allowed to call the API from the web frontend.
WARDROBE_CORS_ORIGINS=http://localhost:5173
